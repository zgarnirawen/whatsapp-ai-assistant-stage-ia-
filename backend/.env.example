# PostgreSQL connection used by Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Groq API key used for intent detection, conversational responses and transcription
GROQ_API_KEY=

# Optional conversational model override
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Intent confidence threshold (0..1); 0.60 is the validated default baseline
INTENT_CONFIDENCE_THRESHOLD=0.60

# Optional backend port
PORT=3000
